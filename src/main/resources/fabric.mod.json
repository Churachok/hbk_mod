{
	"schemaVersion": 1,
	"id": "hbk",
	"version": "${version}",
	"name": "hbk",
	"description": "Adds giant Stalin and giant CJ who wander the world, fight each other, and level it with rockets.",
	"authors": [
		"Kirill"
	],
	"license": "MIT",
	"icon": "assets/hbk/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.kirill.hbk.HbkMod"
		],
		"client": [
			"dev.kirill.hbk.client.HbkClient"
		],
		"jei_mod_plugin": [
			"dev.kirill.hbk.client.compat.jei.HbkJeiPlugin"
		]
	},
	"mixins": [
		"hbk.mixins.json",
		{
			"config": "hbk.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
